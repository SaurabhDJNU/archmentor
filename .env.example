# Copy to .env.local for local development.
# Leave the Supabase values empty to run with sample data (demo mode works in `npm run dev`).
# Supabase → Project Settings → API  (the anon/public key only — never the service_role key)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# A production build without Supabase values shows a "not connected" page.
# Set this to true only for a public demo preview with sample data.
VITE_DEMO_MODE=
# Payment and email secrets NEVER go here. They live in Supabase:
#   Edge Functions → Secrets: RAZORPAY_KEY_ID, RAZORPAY_KEY_SECRET, RAZORPAY_WEBHOOK_SECRET
#   Brevo API key: saved from the website's Settings page (stored encrypted in Supabase Vault)
